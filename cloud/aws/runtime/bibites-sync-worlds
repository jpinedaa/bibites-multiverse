#!/usr/bin/env bash
# Reconcile the private S3 manifest onto the persistent volume. A new world is
# additive. An existing save is never replaced unless --replace-saves is given
# while that world's game is stopped.
set -euo pipefail

replace=0
[ "${1:-}" = --replace-saves ] && replace=1

conf=/etc/bibites-cloud.conf
[ -r "$conf" ] || { echo "missing $conf" >&2; exit 1; }
# shellcheck source=/dev/null
set -a; . "$conf"; set +a

stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT
aws --region "$AWS_REGION" s3 cp "s3://$ARTIFACT_BUCKET/$MANIFEST_KEY" "$stage/worlds.json" --only-show-errors
validator=/opt/bibites-runtime/validate-world-manifest.jq
[ -r "$validator" ] || { echo "missing $validator" >&2; exit 1; }
jq -e -f "$validator" "$stage/worlds.json" >/dev/null
install -m 0644 "$stage/worlds.json" /srv/bibites/worlds.json
case "$MANIFEST_KEY" in
  */*) manifest_prefix="${MANIFEST_KEY%/*}/" ;;
  *) manifest_prefix='' ;;
esac

# A disabled manifest row is durable topology state. Stop and disable its units
# before the enabled rows start. Data remains in place for recovery or migration.
while IFS= read -r world_id; do
  case "$world_id" in (*[!A-Za-z0-9._-]*|'') echo "invalid world id: $world_id" >&2; exit 1;; esac
  systemctl disable --now "bibites-timescale@$world_id.service" \
    "bibites-game@$world_id.service" "bibites-sidecar@$world_id.service" \
    >/dev/null 2>&1 || true
  printf 'disabled %s; data retained\n' "$world_id"
done < <(jq -r '.worlds[] | select((.enabled // true) == false) | .id' "$stage/worlds.json")

while IFS= read -r row; do
  world_id="$(jq -r .id <<<"$row")"
  enabled="$(jq -r '.enabled // true' <<<"$row")"
  [ "$enabled" = true ] || continue
  case "$world_id" in (*[!A-Za-z0-9._-]*|'') echo "invalid world id: $world_id" >&2; exit 1;; esac

  peer_id="$(jq -r .peerId <<<"$row")"
  world_name="$(jq -r .worldName <<<"$row")"
  port="$(jq -r .sidecarPort <<<"$row")"
  save_key="$(jq -r .saveKey <<<"$row")"
  secret_parameter="$(jq -r .credentialParameter <<<"$row")"
  position="$(jq -r '.position // empty' <<<"$row")"
  preferred_slot="$(jq -r '.preferredSlot // empty' <<<"$row")"
  target="$(jq -r '.targetTimeScale // 100' <<<"$row")"
  save_minutes="$(jq -r '.saveMinutes // 10' <<<"$row")"
  save_keep="$(jq -r '.saveKeep // 6' <<<"$row")"

  root="/srv/bibites/worlds/$world_id"
  game="$root/game"
  sidecar_data="$root/sidecar"
  xdg_config="$root/config"
  xdg_data="$root/data"
  logs="$root/logs"
  saves="$xdg_config/unity3d/The Bibites/The Bibites/Savefiles"
  credential="$root/peer-secret.txt"
  env_file="$root/world.env"

  install -d -o bibites -g bibites -m 0750 "$root" "$sidecar_data" "$xdg_config" "$xdg_data" "$logs" "$saves"
  # install creates missing parent directories as root. The game also creates
  # sibling directories below the Unity configuration path at first launch.
  chown -R bibites:bibites "$xdg_config" "$xdg_data"
  if [ ! -x "$game/The Bibites.x86_64" ]; then
    cp -al /srv/bibites/base/game "$game"
    chown -R bibites:bibites "$game"
  fi

  parameter="$(aws --region "$AWS_REGION" ssm get-parameter \
    --name "$secret_parameter" --with-decryption --output json)"
  secret="$(jq -er --arg name "$secret_parameter" '
    .Parameter |
    select(.Name == $name and .Type == "SecureString") |
    .Value |
    select(type == "string" and length > 0)
  ' <<<"$parameter")" || {
    echo "$world_id: credential must be a nonempty SecureString" >&2
    exit 1
  }
  ( umask 077; printf '%s\n' "$secret" > "$credential.new" )
  chown bibites:bibites "$credential.new"
  mv "$credential.new" "$credential"

  save="$saves/$world_name.zip"
  if [ ! -f "$save" ] || [ "$replace" -eq 1 ]; then
    if systemctl is-active --quiet "bibites-game@$world_id.service" 2>/dev/null; then
      echo "$world_id: refusing to replace a save while its game is running" >&2
      exit 1
    fi
    aws --region "$AWS_REGION" s3 cp \
      "s3://$ARTIFACT_BUCKET/$manifest_prefix$save_key" "$save.new" --only-show-errors
    unzip -tqq "$save.new"
    unzip -Z1 "$save.new" > "$stage/save-contents"
    grep -Fxq 'scene.bb8scene' "$stage/save-contents"
    chown bibites:bibites "$save.new"
    mv "$save.new" "$save"
  fi

  command_file="$root/command.txt"
  {
    printf 'WORLD_ID=%q\n' "$world_id"
    printf 'WORLD_NAME=%q\n' "$world_name"
    printf 'PEER_ID=%q\n' "$peer_id"
    printf 'SIDECAR_PORT=%q\n' "$port"
    printf 'RELAY_URL=%q\n' "$RELAY_URL"
    printf 'GAME_DIR=%q\n' "$game"
    printf 'SIDECAR_DATA=%q\n' "$sidecar_data"
    printf 'CREDENTIAL_FILE=%q\n' "$credential"
    printf 'SIDECAR_LOG=%q\n' "$logs/sidecar.log"
    printf 'GAME_LOG=%q\n' "$logs/game.out"
    printf 'COMMAND_FILE=%q\n' "$command_file"
    printf 'CONTRACT_A_TOKEN_FILE=%q\n' "$sidecar_data/contract-a.token"
    printf 'TARGET_TIME_SCALE=%q\n' "$target"
    printf 'PREFERRED_SLOT=%q\n' "$preferred_slot"
    printf 'POSITION=%q\n' "$position"
    printf 'XDG_CONFIG_HOME=%q\n' "$xdg_config"
    printf 'XDG_DATA_HOME=%q\n' "$xdg_data"
    printf 'MULTIVERSE_EXPORT_EDGES=%q\n' 'E,N,W,S'
    printf 'MULTIVERSE_MIGRATION_EXCLUDE=%q\n' 'Basic bibite'
    printf 'MULTIVERSE_SAVE_MINUTES=%q\n' "$save_minutes"
    printf 'MULTIVERSE_SAVE_KEEP=%q\n' "$save_keep"
    printf 'MULTIVERSE_SAVE_ON_QUIT=%q\n' true
    printf 'MULTIVERSE_SIDECAR_PORT=%q\n' "$port"
    printf 'MULTIVERSE_WORLD=%q\n' "$world_name"
    printf 'MULTIVERSE_PORTAL=%q\n' false
    printf 'MULTIVERSE_PORTAL_FLOURISHES=%q\n' false
    printf 'MULTIVERSE_CONTRACT_A_TOKEN_FILE=%q\n' "$sidecar_data/contract-a.token"
    printf 'MULTIVERSE_CMD_FILE=%q\n' "$command_file"
  } > "$env_file.new"
  chown bibites:bibites "$env_file.new"
  chmod 0600 "$env_file.new"
  mv "$env_file.new" "$env_file"

  systemctl enable "bibites-sidecar@$world_id.service" "bibites-game@$world_id.service" \
    "bibites-timescale@$world_id.service" >/dev/null
  systemctl start "bibites-sidecar@$world_id.service"
  systemctl start "bibites-game@$world_id.service"
  systemctl start --no-block "bibites-timescale@$world_id.service"
  printf 'synced %s -> %s (%s)\n' "$world_id" "$world_name" "$peer_id"
done < <(jq -c '.worlds[]' "$stage/worlds.json")
