#!/usr/bin/env bash
set -euo pipefail

: "${AWS_REGION:?}"
: "${DATA_VOLUME_ID:?}"
: "${RELAY_PRIVATE_IP:?}"
: "${RELAY_DOMAIN:?}"
: "${STREAM_RTMP_ADDRESS:?}"
: "${PUBLISH_PASSWORD_PARAMETER:?}"
: "${WORLD_ID:?}"

die() { printf '[bibites-broadcast-install] ERROR: %s\n' "$*" >&2; exit 1; }

[ "$WORLD_ID" = slot-1 ] || die 'WORLD_ID must be slot-1'
die 'broadcast installation is disabled until RTMP credentials can stay out of FFmpeg process arguments'
