#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=/dev/null
. /etc/bibites-broadcast/broadcast.env
env_file="/srv/bibites/worlds/$WORLD_ID/world.env"
[ -r "$env_file" ] || { echo "missing $env_file" >&2; exit 1; }
set -a; . "$env_file"; set +a

cd "$GAME_DIR"
exec ./run_bepinex.sh './The Bibites.x86_64' \
  -screen-width 1280 -screen-height 720 -screen-fullscreen 0 \
  -logFile "$GAME_LOG"
