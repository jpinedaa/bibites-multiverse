[Unit]
Description=Bibites Multiverse sidecar for %i
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/srv/bibites

[Service]
Type=simple
User=bibites
Group=bibites
# The six operator-controlled hosted worlds use the reviewed enforcement rollout.
# Participant packages retain the safer adaptive-shadow default. The estimator
# state lives on the persistent world volume, so this promotion does not relearn
# or fail open on restart.
Environment=MULTIVERSE_INBOUND_ADMISSION=adaptive
ExecStart=/usr/local/libexec/bibites-sidecar %i
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/bibites/worlds/%i

[Install]
WantedBy=multi-user.target
