+
+# contract-b/4.0 (contract-b-m4.md §22, B22 and B23). Three things moved together
+# and not one of them is optional.
+#
+#  * THE PATH IS /contract-b/v4. v2 and v3 are retired: the relay still ANSWERS on
+#    them and closes with 4000, so a stale client reads as a peer that will not
+#    join rather than as a 404.
+#  * THE SCHEME IS wss://, FOR EVERY CLIENT INCLUDING THE LOOPBACK ONES. With
+#    --tls-cert/--tls-key the relay wraps its WHOLE net.Listener in crypto/tls
+#    (internal/relay/tls.go, TLSListener), so no plaintext listener survives on
+#    loopback for the five local sidecars and the archive to use. Measured
+#    2026-08-11: a plain HTTP GET to 127.0.0.1 on a TLS-configured relay answers
+#    `400 Client sent an HTTP request to an HTTPS server`, and NEVER the 426.
+#    B23's 426 is a different rule for a different deployment shape — it is
+#    reached only when r.TLS is nil, and it keys on the LOCAL address the
+#    connection arrived on, not on the bind string and not on the remote address.
+#  * THE SHARED TOKEN IS GONE. --token-file exists on no binary any more.
+RELAY_URL="wss://127.0.0.1:$RELAY_PORT/contract-b/v4"
+RELAY_HEALTH="https://127.0.0.1:$RELAY_PORT/healthz"
+
+# The relay's own TLS material, minted by e2e/crossing/mint-tls.sh into a
+# GITIGNORED directory. The private keys never enter the repository.
+TLS_DIR="${TLS_DIR:-$E2E/tls-m4-lan}"
+TLS_CERT="${TLS_CERT:-$TLS_DIR/relay.crt}"
+TLS_KEY="${TLS_KEY:-$TLS_DIR/relay.key}"
+TLS_CA="${TLS_CA:-$TLS_DIR/ca.crt}"
+
+# TRUSTING THIS RIG'S CA WITHOUT SUDO. A Contract B client verifies with its
+# platform's trust store and there is deliberately no flag between it and one
+# (internal/sidecar/contractb_client.go: "NO TLS CONFIGURATION IS SET HERE AND
+# NONE MAY BE"). Go's crypto/x509 reads SSL_CERT_FILE on Unix and so does curl,
+# so one exported variable trusts this CA for every process this rig starts and
+# changes nothing in /etc. Verified 2026-08-11 against the real binaries: without
+# it the sidecar logs "the relay's TLS certificate did not verify; NOT
+# CONNECTING" and never dials; with it it connects and is granted its slot.
+export SSL_CERT_FILE="${SSL_CERT_FILE:-$TLS_CA}"
+
+# Per-peer credentials (§22, B22). The SECRET half of one join string per
+# identity, one file each, mode 600, OUTSIDE the repository — the rule
+# ~/.multiverse-token already lived by. The peerId half is not a secret and comes
+# from <data-dir>/peer-id. e2e/crossing/mint-credentials.sh writes these files;
+# nothing in this rig mints, because only the relay can.
+SECRETS_DIR="${SECRETS_DIR:-$HOME/.multiverse}"
+ARCHIVE_CREDENTIAL="${ARCHIVE_CREDENTIAL:-$SECRETS_DIR/archive-main.secret}"
+cred_of() { printf '%s/peer-%s.secret\n' "$SECRETS_DIR" "$(peer_of "$1")"; }
+
+# ensure_credentials REPLACES run-m3.sh's ensure_token, which minted the shared
+# LAN token contract-b/4.0 deleted. It mints nothing: a credential is born at the
+# relay, printed once, and captured by e2e/crossing/mint-credentials.sh. All this
+# does is refuse to start a rig whose secrets are not on disk, because the
+# alternative is five sidecars on a backoff ladder against a 401.
+ensure_credentials() {
+  local missing=0 f s
+  for f in "$TLS_CERT" "$TLS_KEY" "$TLS_CA"; do
+    [ -s "$f" ] || { fail "missing TLS material: $f"; missing=1; }
+  done
+  [ -s "$ARCHIVE_CREDENTIAL" ] || { fail "missing the archive's credential: $ARCHIVE_CREDENTIAL"; missing=1; }
+  for s in $SLOTS; do
+    [ -s "$(cred_of "$s")" ] || { fail "missing slot $s's credential: $(cred_of "$s")"; missing=1; }
+  done
+  if [ "$missing" != 0 ]; then
+    fail ""
+    fail "Mint them first, in this order:"
+    fail "    e2e/crossing/mint-tls.sh"
+    fail "    e2e/crossing/mint-credentials.sh"
+    return 1
+  fi
+}
 
