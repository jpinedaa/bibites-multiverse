# Parameters for one hosted relay and archive.
#
# Copy this file to /etc/multiverse/deploy.env.
# Keep the installed file at mode 0640 with owner root:multiverse.
# Do not commit the completed file.
#
# The alert URL can be a secret capability.
# No join string, private key, or cloud credential belongs in this file.

# ---------------------------------------------------------------- name and TLS

# Replace this placeholder with the stable public service name.
MV_DOMAIN=multiverse.example.org

# Add certificate names separated by spaces. Empty is valid.
MV_CERT_EXTRA_NAMES=

# Replace this placeholder with the ACME contact address.
MV_ACME_EMAIL=CHOOSE@example.org

# webroot uses HTTP-01 through nginx. The public kit does not configure DNS-01.
MV_ACME_MODE=webroot

# ---------------------------------------------------------------- listeners

MV_RELAY_PORT=443
MV_RELAY_BACKEND=127.0.0.1:8795
MV_ARCHIVE_HTTP=127.0.0.1:8796

# ---------------------------------------------------------------- public installer enrollment

# The bundled installer creates a different relay credential on each machine.
# nginx exposes only POST /api/enroll. The relay stores a verifier, not the
# secret that the installer generated. Set this to 0 to stop new automatic
# enrollments without disconnecting existing worlds.
MV_PUBLIC_ENROLLMENT=1

# Total automatically enrolled credentials. Manually issued identities and the
# archive identity do not count against this limit. Raise it deliberately after
# checking the map's connection and storage capacity.
MV_PUBLIC_ENROLLMENT_MAX=256

# New identities allowed from one public network address in one window. A retry
# with the same install identity does not consume another entry.
MV_PUBLIC_ENROLLMENT_PER_ADDRESS=8
MV_PUBLIC_ENROLLMENT_WINDOW_HOURS=24

# ---------------------------------------------------------------- optional live broadcast origin

# Keep this disabled unless the deployment has a private RTMP source network.
MV_STREAM_ORIGIN_ENABLED=0

# When enabled, use an RFC1918 address on port 1935.
MV_STREAM_RTMP_ADDRESS=

# When enabled, identify the private publisher CIDR.
MV_STREAM_PUBLISH_CIDR=

# nginx is the only public HLS reader.
MV_STREAM_HLS_BACKEND=127.0.0.1:8888

# ---------------------------------------------------------------- retention policy

# Select one rule before a participant joins:
#   keep-everything
#   bounded-ledger
#   prune-genomes
#   graduate
#   rollup-window
#
# WIND-DOWN.md's table states what each one keeps. `rollup-window` is the rule
# this kit's archive implements when a horizon is set: every ANSWER is kept for
# the whole run and beyond, the RAW CROSSING LINES are kept on the server for
# the window below and off-server for the run, and a line only leaves the server
# once a confirmed off-host copy exists. It is three tiers, not two, and all
# three must be stated to a participant before they join (ANNOUNCEMENT.md,
# enrollment fact 3).
#
# The public example uses the contract-safe rule that removes nothing.
# Record the selected deployment rule in participant documents and private operations storage.
MV_RETENTION=keep-everything

# A Go duration such as 720h. Empty keeps all genome blobs.
# A shorter value removes blobs during the run and must be announced first.
#
# This is the PERMANENT-DELETE horizon. It and the hot window below are two
# different rules and a deployment may run either, both, or neither: the horizon
# DELETES a blob for good; the hot window moves it to a reversible off-host copy.
MV_ARCHIVE_GENOME_HORIZON=

# ---------------------------------------------------------------- the genome hot window

# How long a genome BLOB is kept in the HOT store on this host, as a Go duration
# such as 168h (7 days). Empty or 0 keeps every blob hot forever, which is the
# default. Past the window a blob is BUNDLED to <data-dir>/genome-bundles and, once
# deploy/coldcopy.sh has written a receipt confirming an off-host copy, REMOVED
# from the hot store — and it restores on demand when the genealogy reads it.
#
# THE COLD COPY IS THE GATE, exactly as it is for the ledger window: with
# MV_COLDCOPY=off no receipt is ever written, so nothing retires and the disk
# fills — the safe failure direction. genomeBundlesAwaitingColdCopy on /api/status
# is what climbs when the cold archive has stopped working.
#
# It is INDEPENDENT of MV_ARCHIVE_GENOME_HORIZON: the horizon is a permanent
# delete, the hot window is a move to cold. The hosted run sets 168h here.
MV_GENOME_HOT_WINDOW=

# On-demand restore path for a cold genome. When a genealogy read misses the hot
# store and the hash is in the cold index, the archive shells this with
# `--restore <bundle>` to re-admit the blob. Leave empty to accept the default:
# provision.sh points it at the installed /opt/multiverse/deploy/coldcopy.sh
# whenever MV_GENOME_HOT_WINDOW is set, so on-demand availability is real without
# extra configuration. Set explicitly only to override that path or to force it
# empty (which disables restore — cold genomes then draw no ring, never an error).
MV_COLDCOPY_SCRIPT=

# ---------------------------------------------------------------- the duplicate window

# How far back the archive remembers a record it has already written, so that a
# second copy of one is refused. Empty takes the contract's own default, which
# is also 48h.
#
# IT IS ALSO WHAT A RESTART COSTS. Since the roll-up, the aggregates come back
# out of the state sidecar and the only raw the replay still has to parse is
# this window: the restart reads `min(the raw window on this host, this value)`
# of records and nothing else. 48h over a real 5.4-million-record ledger
# measured 51.5 s; the same binary and the same state at 1h measured 14.3 s.
#
# 48h IS SIZED AGAINST THE OLDEST SIDECAR THE MAP MIGHT STILL HOLD, not against
# a relay retransmit — a sender hands each migration over once now
# (contract-b-m4.md §25 B37), so what can still send a second copy is a peer
# running a build older than that amendment, and it does so within seconds.
#
# LOWER IT TO 1h ONCE THE PARTICIPANT RELEASE CARRYING B37 HAS BEEN OUT FOR A
# CYCLE, and only then. `duplicatesRefused` on /api/status is the evidence: it
# is all-time and it is not omitted when it is zero, because zero is the answer
# that says the fleet has crossed and this value may come down. A refused
# duplicate leaves no other trace anywhere.
#
# Do not set it to 0. An archive with no window records a duplicate row for
# every retry one old peer sends, and nothing rewrites the record afterwards.
MV_ARCHIVE_DEDUP_WINDOW=48h

# ---------------------------------------------------------------- the raw ledger window

# How long a CLOSED LEDGER SEGMENT is kept on this host, as a Go duration.
# Empty takes MV_ARCHIVE_GENOME_HORIZON, which is the intended setting: ONE
# HORIZON, THREE MECHANISMS. The genome store evicts blobs past the horizon, the
# fetch queue retires gaps whose crossing is past it, and the raw ledger keeps
# exactly the crossings whose gaps can still be fetched. A negative value keeps
# every segment forever whatever the horizon is.
#
# IT IS THE RAW LINES ONLY. Every answer the archive publishes is kept forever at
# every setting. A shorter raw window changes what can be RE-DERIVED later, which
# is a published promise and must be announced first.
MV_LEDGER_WINDOW=

# ---------------------------------------------------------------- the raw metrics window

# How long a CLOSED METRICS SEGMENT is kept on this host, as a Go duration such as
# 720h. Empty or 0 keeps metrics.jsonl whole and unrotated, which is the default
# and is exactly this archive's original behaviour. Past the window the archive
# rotates metrics.jsonl into dated segments, FOLDS each closed day into a persisted
# history rollup, and removes the raw segment behind a confirmed off-host copy.
#
# THE HISTORY SURVIVES. The operator's history strip is drawn from the rollup, not
# from the raw file, so a day whose raw segment has retired is still on the strip.
# This knob governs only the RAW SAMPLES. metricsSegmentsAwaitingColdCopy on
# /api/status is the gate's health, the same shape as the ledger's. It is
# INDEPENDENT of the genome knobs; the hosted run sets 720h.
MV_METRICS_WINDOW=

# ---------------------------------------------------------------- off-host copy

# The off-host copy of closed ledger segments, and the GATE on the window above:
# the archive removes no segment until deploy/coldcopy.sh has written a receipt
# confirming the segment is in the store and matches the bytes on this disk.
# off (the default) means nothing is copied and therefore nothing is ever
# removed, whatever MV_LEDGER_WINDOW says.
#   off   no off-host copy
#   s3    an S3 or S3-compatible bucket through the AWS CLI
MV_COLDCOPY=off

# s3://bucket/prefix. The object key is <prefix>/<segment file name>.
#
# EMPTY IS THE SAFE DEFAULT AND IT DISABLES THE WHOLE MECHANISM: no object is
# copied, no receipt is written, and therefore NOTHING IS EVER RETIRED from this
# host, whatever MV_LEDGER_WINDOW says. That is the designed failure direction —
# a cold archive that is absent or broken shows up as
# ledgerSegmentsAwaitingColdCopy climbing and as a disk filling, never as a
# record that is gone.
#
# A BUCKET NAME IS A LIVE RESOURCE IDENTIFIER. It belongs in this file on the
# host and in the private operations record, and it must not be committed to
# this repository. Run `deploy/coldcopy.sh --check` after setting it, before the
# first real copy.
MV_COLDCOPY_URI=

# Empty for AWS S3 itself. An S3-compatible store — a Lightsail bucket, for
# instance — puts its endpoint here and nothing else changes.
MV_COLDCOPY_ENDPOINT=

# An AWS CLI profile name, or empty to use the host's default credentials.
# NEVER PUT A KEY VALUE IN THIS FILE. Store the secret in its designated secret
# manager and record only its name, owner and rotation date in private
# operations storage. A destination the instance can reach WITHOUT a key on the
# host is the better shape: see deploy/README.md.
MV_COLDCOPY_PROFILE=

# The storage class for an object written once and read only in a recovery.
#
# STANDARD, not STANDARD_IA, and the reason is measured rather than theoretical:
# a Lightsail bucket's own policy DENIES STANDARD_IA, ONEZONE_IA and
# INTELLIGENT_TIERING outright and allows STANDARD and GLACIER_IR. On the old
# default every upload returned 403, no receipt was ever written, and nothing
# retired — the window nominally on and doing nothing. A bucket billed at a flat
# bundle price charges the same for every class, so the cheaper class bought
# nothing there.
#
# Change it only for a store that prices classes separately AND allows the class
# you choose. `coldcopy.sh` fails loudly and names this variable when a store
# refuses the write; it does not retry a denial.
MV_COLDCOPY_STORAGE_CLASS=STANDARD

# Informational name for the selected provider size. Do not put a resource ID here.
MV_BUNDLE=CHOOSE

# ---------------------------------------------------------------- archive memory

# Go soft heap limit. Select it from the host's ARCHIVE CEILING, not from total
# RAM: the ceiling is MemTotal less the memory no other process on the box will
# return, and SIZING.md "Archive memory" gives the rule
#
#     MV_ARCHIVE_GOMEMLIMIT <= archive_ceiling / 1.14
#
# where 1.14 is the measured excursion of peak over settled under a binding
# limit. 1100MiB is that rule on a 2 GB host with a measured 1,534 MiB ceiling.
#
# It is a SOFT limit and it cannot fail a replay: a limit set below the live
# heap ran the collector continuously, replayed every record and left the ledger
# byte-identical. What it buys is resident set, by removing collector headroom,
# and on two vCPUs that headroom is 15 to 22 percent larger than on a big box.
# What it does NOT do is reduce retained state, and it does NOT move the
# replay-headroom ratio below, which is a model of record count.
#
# Empty leaves the limit unset. Changing it needs `--only envfiles` and a
# restart: the value is read at exec time.
MV_ARCHIVE_GOMEMLIMIT=1100MiB

# Optional systemd MemoryHigh value. Empty creates no override.
MV_ARCHIVE_MEMORY_HIGH=

# Swap-file size in GB. It is a crash barrier and not replay capacity, so the
# monitor's replay-headroom gate does not count it; the monitor's separate
# `swap` check reports whether it exists and whether it is being used, and
# sustained use means the host needs more memory or less retained state.
# A non-zero value also writes vm.swappiness=10, which keeps the steady-state
# processes resident and still lets a replay peak spill.
#
# 0 is the default because a swap file is a per-host decision that has to be
# recorded. Set it only where the record says so; do not add swap to clear a
# memory verdict, because it cannot clear one.
MV_SWAP_GB=0

# ---------------------------------------------------------------- alerting

# ntfy | webhook | command | none
MV_ALERT_KIND=none

# This value can be a secret capability. Store it only in the installed file.
MV_ALERT_URL=

# For command alerts, the program reads message text from stdin.
# Its first two arguments are severity and check name.
MV_ALERT_COMMAND=

MV_ALERT_REPEAT_HOURS=12
MV_HEARTBEAT_HOUR=9

# ---------------------------------------------------------------- monitor thresholds

# Zero disables the minimum-live-peer floor. Raise it after the map is populated.
MV_EXPECTED_PEERS=0

MV_STATUS_AGE_WARN_MS=120000
MV_BYPASS_RUNS=3
MV_DISK_WARN_PCT=25
MV_DISK_CRIT_PCT=12
MV_ERROR_ALERT=5
MV_GAPS_DELTA_ALERT=20000
MV_CERT_MIN_DAYS=10

# Fraction of PHYSICAL RAM allowed for projected archive memory. Swap is not in
# that denominator: adding a swap file would otherwise halve the number this
# gate reports while the ledger, the retained state and the replay were all
# exactly as they were. Swap has its own check below.
MV_REPLAY_HEADROOM=0.85

# The per-record memory model the gate above projects with, in whole bytes per
# ledger record. SIZING.md "Archive memory" owns these values and states the
# workload they were measured on. They are settable so that a measurement taken
# on THIS host's ledger can retune the gate without a new release. Changing them
# changes when the gate trips and nothing else.
#
# BOTH CARRY THE SAME VALUE, and that is the measurement, not a shortcut: the
# replay peak and the settled resident set were 0.06 percent apart in every run
# with no binding limit. There is one memory term, not two. monitor.sh keeps its
# max() against a future model change.
#
# 110 is the resident set measured on 2026-08-16, on two pinned cores, replaying
# a real 5,408,123-record ledger with the fingerprinted duplicate-suppression
# set and NO genome store — a restore from the ledger alone, which is the worst
# shape a real start can take. The live service shape measured about 64 B, so
# this value carries 1.7x of margin and still describes a replay this host can
# be asked to run. The build before the fingerprint change needed 280 here, and
# monitor.sh's own defaults (184 and 300) are the older reference-workload
# figures, kept conservative so an unconfigured host errs toward calling itself
# full rather than free.
MV_REPLAY_PEAK_B=110
MV_REPLAY_RESIDENT_B=110

# THE RESTART'S COST IN SECONDS, which is a different question from whether it
# fits. A record-preserving archive restart holds the relay down for the length
# of the replay, so the projection below is the participant outage and it is
# what an announcement has to state.
#
# monitor.sh projects it from two numbers the archive MEASURES at its own last
# start — replayRawSeconds and replayRawRecords on /api/status — and from the
# duplicate window above, which is what bounds the next one. It is a projection
# of the next restart, not a memory about the last one. When the archive does
# not publish those fields the check says so and the record-count memory model
# is the only estimate left.
#
# Thresholds in whole seconds. 180 is three minutes of held-down relay, which is
# an announcement; 600 is ten, which is a scheduled window. A deployment that
# has accepted a longer outage raises them and says so in its own record.
MV_REPLAY_SECONDS_WARN=180
MV_REPLAY_SECONDS_CRIT=600

# The roll-up state sidecar saves every 30 s. A sidecar that stopped saving is a
# silent restart-cost regression: nothing fails, no number moves, and the next
# restart replays from where the file stopped instead of from where the archive
# is. Warn when rollupSavedAtMs is older than this many seconds.
MV_ROLLUP_STALE_S=900

# Closed segments waiting for their off-host copy. One is normal for the hour
# after a rotation; a day of them means the copy has stopped and the archive is
# holding raw the window says it should not be. Hours before the count is
# reported, and the multiple of the ledger window at which the backlog is
# treated as critical rather than late.
MV_COLDCOPY_WAIT_HOURS=24
MV_COLDCOPY_WINDOW_FACTOR=2

# Swap, watched as its own reading rather than counted as headroom. Report it
# when this percentage of the swap device stays in use for this many
# consecutive five-minute passes. SIZING.md reads sustained swap activity as a
# sizing signal — the instance needs more memory or less retained state — and a
# single replay peak that spills and is reclaimed is not that.
MV_SWAP_USED_WARN_PCT=25
MV_SWAP_USED_RUNS=3

# ---------------------------------------------------------------- data transfer

# The bundle's monthly transfer allowance in the PROVIDER's GB, which is 2^30
# bytes and the same base as the free-disk figures above. It is counted in BOTH
# directions, and overage is billed per GB and is NOT throttled, so going over
# is an invoice rather than an outage. Set it to the figure your bundle states.
MV_TRANSFER_ALLOWANCE_GB=3072

# Warn at this percentage of the allowance, taking the higher of the
# month-to-date burn-down line and the last 24 closed hours' projected month.
# A hundred percent is critical.
MV_TRANSFER_WARN_PCT=80

# Points of clearance the figure must gain below a threshold before the severity
# steps back DOWN. A deployment whose steady state sits on the line would
# otherwise alert and recover every five minutes until somebody muted it.
MV_TRANSFER_HYST_PCT=3

# Empty reads the default-route interface from /proc/net/route. Name the billed
# interface here if the host has more than one. The monitor unit forbids
# AF_NETLINK, so `ip` cannot be used to find it and must not be introduced.
MV_TRANSFER_IFACE=

# The rate trip: in and out together above this many GB in one closed hour, for
# this many consecutive hours, is a driver that just appeared. Keep it well
# above the rate the allowance sustains so that it means "something started"
# rather than "this month is busy".
MV_TRANSFER_HOURLY_GB=9
MV_TRANSFER_HOURLY_RUNS=3

# ------------------------------------------------- daily billing reconciliation

# The transfer knobs above watch this host's own NIC counter, which needs no
# cloud credential and is the only instrument this host can hold. It is a proxy.
# `deploy/ce-reconcile.sh` audits it against the invoice: it runs on an OPERATOR
# machine once a day, makes exactly one Cost Explorer call, and writes
# `billing.json` into the monitor's state directory over ssh. This host still
# holds no cloud credential, which is the point.
#
# The two knobs below belong to the monitor's `billing` check, which reads that
# file. The script itself is configured from the operator machine's environment
# and reads nothing from this file.

# Hours before a reconciliation is stale. A daily job, plus one missed run, plus
# the provider's own roughly fourteen-hour billing lag, all fit inside 36 — so
# one failed run is not an alert and two are. Missing or stale is a WARNING and
# never a critical: the NIC counter is still watching the allowance, so what has
# been lost is the audit and not the alarm.
MV_BILLING_STALE_HOURS=36

# How far the metric-over-invoice ratio may sit from 1 before the two
# instruments are called into question. The measured residual is a systematic
# 1.01 and is NOT corrected anywhere — correcting a residual nobody can explain
# hides the day it changes. 0.10 lets 1.01 through and still catches a counter
# that has started reading the wrong interface, the wrong instance, or a
# decimal GB.
MV_BILLING_RATIO_TOL=0.10

# ---------------------------------------------------------------- backups

MV_BACKUP_KEEP=168
MV_BACKUP_LEDGER=auto
MV_BACKUP_LEDGER_MIN_FREE_PCT=30
MV_BACKUP_GENOMES=1
MV_BACKUP_DAILY_HOUR=4

# ---------------------------------------------------------------- announced period

# Replace both placeholders before a participant joins.
MV_PERIOD_START=YYYY-MM-DD
MV_PERIOD_END=YYYY-MM-DD

# ---------------------------------------------------------------- paths and identity

MV_USER=multiverse
MV_GROUP=multiverse
MV_PREFIX=/opt/multiverse
MV_STATE=/var/lib/multiverse
MV_LOGDIR=/var/log/multiverse
MV_TLSDIR=/etc/multiverse/tls
MV_STAGE_DIR=/home/ubuntu/multiverse-stage

# ---------------------------------------------------------------- CI deployments

# The PUBLIC half of the deployment key that a CI system uses, if this
# deployment has one. One line, in the same form as an authorized_keys entry
# without the options: "ssh-ed25519 AAAA... mv-deploy-ci".
#
# EMPTY IS THE DEFAULT and is correct for a deployment that is only ever
# operated by hand. Setting it turns on one extra check in the verify phase:
# that this key is present in the login account's authorized_keys AND is pinned
# to command="/opt/multiverse/deploy/ci-gate.sh" with port, agent, pty and X11
# forwarding all denied.
#
# That check exists because its failure is silent. The login account has
# passwordless sudo, so a CI key that loses its forced command is root on this
# host, the service looks identical, and deployments keep working.
#
# NEVER put the private half here, or anywhere on this host, or in any
# repository. It belongs in the CI system's secret store and nowhere else.
# This value is a public key: it is not a secret, and it is not a credential.
MV_CI_DEPLOY_KEY_PUB=

# The archive credential has the subscribe grant and cannot claim a map slot.
MV_ARCHIVE_PEER_ID=archive-main

# The peer id of the world the shared camera at /watch is showing. NOTHING ON
# THE WIRE CARRIES THIS: a world does not announce that it is being filmed, so
# the deployment that runs the publisher is the only party that knows. With it
# set, /watch names that world and draws its place in the grid, and the live map
# badges the same world and links back to the broadcast.
#
# EMPTY IS THE DEFAULT and is correct for a map with no broadcast: both pages
# then say the world is unknown rather than name the wrong one. It is display
# only — it changes no placement, no routing and no record — and it is a public
# identifier, not a secret. Change it when the publisher moves to another world.
MV_BROADCAST_PEER_ID=

# Homepage metadata for the public landing page's links. There is no release
# value here: the page's download buttons address GitHub's /releases/latest, so
# they follow the newest published release on their own and a release never
# needs this host to be touched. The page prints that release number beside the
# buttons, and it is not a value here either — the archive reads it from
# api.github.com/repos/$MV_HOMEPAGE_REPO/releases/latest once an hour in the
# background, anonymously, never on the request path, and prints nothing at all
# rather than a guess when the lookup fails. That is the ONE thing this host
# needs outbound HTTPS to github.com for; block it and the page loses the line
# and nothing else. An MV_HOMEPAGE_RELEASE= line left over in a host's copy of
# this file is ignored and harmless; delete it at the next deployment.
MV_HOMEPAGE_REPO=jpinedaa/bibites-multiverse
MV_HOMEPAGE_GAME_VERSION=0.6.3.1

MV_LOG_ROTATE_MB=100
MV_LOG_KEEP=5
MV_LOG_LEVEL=info

# Where nginx writes the front door's own access and error logs.
#
# Deliberately NOT /var/log/nginx. The distribution's logrotate stanza globs
# /var/log/nginx/*.log with no size trigger, so a busy day is only noticed at
# midnight, and this host shares one disk with a ledger that grows without
# asking. The kit ships its own policy for this directory instead, and a second
# policy matching the same path would make logrotate refuse to rotate anything.
#
# Two more files carry this directory and all of them must move together:
# deploy/viewers-presence.sh reads the access log at this path, and
# deploy/systemd/multiverse-viewers.service names the directory in ReadOnlyPaths.
# deploy/test-units.sh checks those two against each other.
MV_NGINX_LOGDIR=/var/log/multiverse/nginx

# Where restart-relay.sh drops the peer gate, and the directory the front door
# globs for `*.map`. An empty directory is the normal state and a valid
# configuration: the gate is raised by writing one file into it and lowered by
# removing it, with an nginx reload either way.
#
# provision.sh renders this into deploy/nginx/multiverse-20-status.conf and
# creates the directory; deploy/restart-lib.sh writes the gate file into it.
# Both read this one key, so they cannot disagree. They used to: provision.sh
# hard-coded the path, so a host that moved it here got a gate written where
# nginx never looks — raised as far as restart-relay.sh could tell, and open to
# every peer.
MV_GATEDIR=/etc/multiverse/nginx-gates

# Leave empty unless the published release supports the selected floor.
MV_MIN_CONTRACT_VERSION=
