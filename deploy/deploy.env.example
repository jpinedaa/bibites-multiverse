# The hosting kit's one parameter file.
#
# Copy to /etc/multiverse/deploy.env on the instance (mode 0640, root:multiverse)
# and fill in the four things that are still the owner's. Every script in
# deploy/ reads this file and nothing else; there is no second place a value
# hides.
#
#     sudo install -d -m 0750 /etc/multiverse
#     sudo install -m 0640 deploy.env.example /etc/multiverse/deploy.env
#     sudo nano /etc/multiverse/deploy.env
#
# WHAT IS STILL OPEN, 2026-08-12. Four values below are marked CHOOSE. Three of
# them are waiting on something outside this kit and the kit is built so that
# filling them in is the whole of the change:
#
#   MV_DOMAIN            the owner is registering a name. It is PERMANENT for the
#                        run: it is baked into every join string ever minted
#                        (wp3_hosting_options.md, "what changing the name costs").
#   MV_RETENTION         Decision 3's rule. It is waiting on the GOMEMLIMIT replay
#                        experiment, and it decides the Lightsail bundle, the two
#                        memory values below, the backup tier and one arm of
#                        WIND-DOWN.md. See SIZING.md.
#   MV_ARCHIVE_GOMEMLIMIT / MV_SWAP_GB   the experiment's verdict.
#   MV_ALERT_URL         one line, no account. See monitor.sh's header.
#
# NOTHING HERE IS A SECRET except by accident: MV_ALERT_URL is a capability URL
# (whoever holds it can post to the topic), which is why the file is 0640 and not
# 0644. No credential, no key and no token belongs in this file.

# ---------------------------------------------------------------- the name

# CHOOSE. The one name every participant's sidecar will hold forever. No scheme,
# no port, no trailing dot. Its A record must already point at this instance's
# STATIC IP before provision.sh runs, or ACME cannot issue.
MV_DOMAIN=CHOOSE.example.org

# Extra names to put on the same certificate, space separated. Empty is normal.
# A second name costs nothing at issuance and cannot be added later without a
# re-issue, so put `status.<domain>` here now if there is any chance of wanting
# the page under its own name.
MV_CERT_EXTRA_NAMES=

# The address for Let's Encrypt's expiry warnings. It is the last line of defence
# behind monitor.sh's certificate check.
MV_ACME_EMAIL=CHOOSE@example.org

# webroot | dns
#   webroot  HTTP-01 through nginx on port 80. Works with EVERY registrar and
#            needs no API credential. The default, and the reason port 80 is
#            open. See README.md, "TLS on 443, and why port 80 is the fourth
#            rule".
#   dns      DNS-01. Needs a certbot plugin for the registrar the owner picks,
#            and that choice has not been made. provision.sh REFUSES rather than
#            guesses; it prints what to install.
MV_ACME_MODE=webroot

# ---------------------------------------------------------------- the ports

# The relay's own TLS listener. The owner's call, 2026-08-12: the map is on 443
# so that participants behind restrictive networks reach it. Changing it after
# the first join string is minted is a message to people who may be unreachable.
MV_RELAY_PORT=443

# The status page's own port, TLS-terminated by nginx. NOT 443: the relay owns
# 443 whole, and fronting both behind one proxy is the expensive version the
# options document priced and the owner declined.
MV_STATUS_PORT=8443

# The archive's own listener. LOOPBACK, deliberately. docs/defaults-audit.md's
# finding for WP3 is exactly the habit of binding this to 0.0.0.0 on a public
# host; nginx is what publishes the page, and it publishes it read-only, rate
# limited and over TLS. Do not change this to an external address.
MV_ARCHIVE_HTTP=127.0.0.1:8796

# ---------------------------------------------------------------- Decision 3

# CHOOSE, after the GOMEMLIMIT experiment. One of:
#   keep-everything   the ledger and the genome store grow for the whole run.
#                     Sizes the 8 GB bundle, needs GOMEMLIMIT and/or swap proven,
#                     and WIND-DOWN.md's arm A applies.
#   bounded-ledger    the ledger is bounded by the retention rule. 2 GB bundle,
#                     the archive restarts in seconds, wind-down arm B applies.
#   prune-genomes     the ledger is kept whole and the genome store is pruned to
#                     a horizon. Wind-down arm B applies to the store only.
#   graduate          the archive becomes M7's catalog ancestor at the ending.
#                     Wind-down arm B, with D6's graduation call recorded.
# It changes NOTHING a script does except the two memory values, the backup tier
# and which arm of the wind-down is announced. It is written here so that the
# rule has one home rather than living in a person's memory (Decision 3, Risk 5).
MV_RETENTION=CHOOSE

# The Lightsail bundle actually bought. Informational: monitor.sh reads the real
# memory from the kernel, not from here. Recorded so the box says what it was
# sized for. One of 2gb | 4gb | 8gb.
MV_BUNDLE=CHOOSE

# ---------------------------------------------------------------- the memory verdict

# CHOOSE, from the experiment. Go's soft heap ceiling for the archive, e.g.
# "6GiB". EMPTY means unset, which is today's behaviour: ~1.30 KB of peak per
# ledger record during replay and ~77% of it garbage. Setting it trades RSS for
# GC CPU and can turn a 9-minute replay into a longer one — which is why it is a
# measurement and not a default.
MV_ARCHIVE_GOMEMLIMIT=

# systemd MemoryHigh for the archive: a SOFT cgroup ceiling that throttles and
# reclaims rather than killing. Empty writes no drop-in. There is deliberately no
# MemoryMax knob here: a hard cap kills the replay, and the replay is the one
# thing that must not fail.
MV_ARCHIVE_MEMORY_HIGH=

# Swap file size in GB, 0 for none. Swap is the other half of the same verdict:
# it is what lets a replay peak exceed RAM at the cost of time. On a 2 GB bundle
# with keep-everything, swap is not optional.
MV_SWAP_GB=0

# ---------------------------------------------------------------- alerting

# CHOOSE. ntfy | webhook | command | none. See monitor.sh.
MV_ALERT_KIND=ntfy

# For ntfy: a topic nobody can guess. Make one and keep it:
#     echo "https://ntfy.sh/multiverse-$(head -c 9 /dev/urandom | base64 | tr -d '/+=')"
# Subscribe on the phone app or at that URL in a browser. No account, no signup,
# no cost. Whoever knows the URL can read AND post, so treat it as a secret and
# never put it in a document.
MV_ALERT_URL=

# For MV_ALERT_KIND=command only: a program that receives the alert text on
# stdin, with $1 = severity and $2 = check name.
MV_ALERT_COMMAND=

# How long a check may stay bad before it is re-announced. A monitor that alerts
# on every tick gets muted, and a muted monitor is not monitoring; a monitor that
# alerts once and then goes quiet lets a real problem age out of memory. This is
# the compromise: alert on the CHANGE, then once every this many hours while it
# lasts, then once more when it recovers.
MV_ALERT_REPEAT_HOURS=12

# The hour (UTC, 0-23) at which monitor.sh sends its daily "still alive" line.
# This is the dead-man's half of the design: an alert that never arrives because
# the box is off is indistinguishable from silence, and this is what makes the
# silence visible. -1 disables it.
MV_HEARTBEAT_HOUR=9

# ---------------------------------------------------------------- monitor thresholds

# How many peers the map is expected to hold. monitor.sh alerts when the live
# count falls below it. The exit-test bar is 4 non-owner peers plus the owner.
MV_EXPECTED_PEERS=1

# A PEER_STATUS older than this means the archive is connected but the map has
# gone quiet. 120000 ms = two minutes, against a broadcast rate measured at
# ~44/min.
MV_STATUS_AGE_WARN_MS=120000

# A lane bypass is normal for a moment and news when it persists. This is how
# many consecutive monitor runs (5 min apart) a non-empty skip list must survive
# before it is an alert. Risk 4: route-around hides a dead peer.
MV_BYPASS_RUNS=3

# Free space on the data filesystem, percent.
MV_DISK_WARN_PCT=25
MV_DISK_CRIT_PCT=12

# Error lines per monitor interval before it is an alert. 0 would page on every
# transient; this is a rate, and the log is where the detail is.
MV_ERROR_ALERT=5

# genomeGaps growth over 24 h before it is an alert. The gap queue is the
# archive's arrears on genome capture and Risk 7 says the unpaid part is
# permanent. On the rig it moved 46,000 -> 155,000 in two days at S=67.9; at a
# public map's rate anything like that is news.
MV_GAPS_DELTA_ALERT=20000

# Days of certificate life left before it is an alert. certbot renews at 30.
MV_CERT_MIN_DAYS=10

# The fraction of (RAM + swap) that the PROJECTED replay peak may reach before
# the archive is declared un-restartable. This is the tripwire the options
# document asked for: 1.30 KB per ledger record, and at the exit-test bar an
# 8 GB box crosses it around day 26 under keep-everything.
MV_REPLAY_HEADROOM=0.85

# ---------------------------------------------------------------- backup

MV_BACKUP_KEEP=168            # identity snapshots to keep (hourly -> 7 days)
MV_BACKUP_LEDGER=auto         # auto | always | never — the compressed ledger copy
MV_BACKUP_LEDGER_MIN_FREE_PCT=30   # `auto` skips the copy below this free space
MV_BACKUP_GENOMES=1           # hardlink snapshot of the genome store (near-free)
MV_BACKUP_DAILY_HOUR=4        # UTC hour for the heavy tier

# ---------------------------------------------------------------- D24

# The announced period. Chosen by the owner 2026-08-11: THREE MONTHS. Fill both
# dates the day the map opens; ANNOUNCEMENT.md and WIND-DOWN.md consume them, and
# they are what a participant is told before joining.
MV_PERIOD_START=YYYY-MM-DD
MV_PERIOD_END=YYYY-MM-DD

# ---------------------------------------------------------------- paths and identity

MV_USER=multiverse
MV_GROUP=multiverse
MV_PREFIX=/opt/multiverse
MV_STATE=/var/lib/multiverse
MV_LOGDIR=/var/log/multiverse
MV_TLSDIR=/etc/multiverse/tls
MV_STAGE_DIR=/home/ubuntu/multiverse-stage

# The archive's identity on the ring. Its credential carries the SUBSCRIBE grant,
# which is disjoint from `peer`: it cannot claim a slot (B27).
MV_ARCHIVE_PEER_ID=archive-main

# Log rotation, per process. The ceiling is MB x (KEEP+1) and the disk budget
# counts two processes: 100 x 6 x 2 = 1.2 GB.
MV_LOG_ROTATE_MB=100
MV_LOG_KEEP=5
MV_LOG_LEVEL=info

# The relay's minimum contract version. UNSET IS THE DEFAULT and it is a
# deployment decision, not a security control (B25). Raise it only AFTER the
# release that satisfies it is published, and expect it to partition the map
# along a version boundary until every participant has upgraded.
MV_MIN_CONTRACT_VERSION=
