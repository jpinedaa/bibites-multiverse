# The hosting kit's one parameter file.
#
# Copy to /etc/multiverse/deploy.env on the instance (mode 0640, root:multiverse)
# and fill the owner-specific email and alert values. Every deployment script
# reads this file. No second parameter file exists.
#
#     getent group multiverse >/dev/null || sudo groupadd --system multiverse
#     sudo install -d -m 0750 -o root -g multiverse /etc/multiverse
#     sudo install -o root -g multiverse -m 0640 deploy.env.example \
#                  /etc/multiverse/deploy.env
#     sudo nano /etc/multiverse/deploy.env
#
# THE GROUP IS NOT DECORATION, and `install` under sudo gives root:root unless
# -o/-g say otherwise. monitor.sh and backup.sh run as the multiverse user and
# exit 2 on a file they cannot read, so root:root here means both timers fail on
# every tick with nothing announcing it. provision.sh's envfiles phase re-asserts
# this ownership and its verify phase reads the file AS the multiverse user, so
# there are two guards; this command is the first of them.
#
# The domain, bundle, retention rule, memory settings, and period below match the
# live deployment. Fill `MV_ACME_EMAIL` and the selected alert fields on the
# instance. Do not store the alert capability in this repository.
#
# NOTHING HERE IS A SECRET except by accident: MV_ALERT_URL is a capability URL
# (whoever holds it can post to the topic), which is why the file is 0640 and not
# 0644. No credential, no key and no token belongs in this file.

# ---------------------------------------------------------------- the name

# The one name every participant's sidecar will hold forever. No scheme,
# no port, no trailing dot. Its A record must already point at this instance's
# STATIC IP before provision.sh runs, or ACME cannot issue.
MV_DOMAIN=bibitesmultiverse.com

# Extra names to put on the same certificate, space separated. Empty is normal.
# A second name costs nothing at issuance and cannot be added later without a
# re-issue, so put `status.<domain>` here now if there is any chance of wanting
# the page under its own name.
MV_CERT_EXTRA_NAMES=status.bibitesmultiverse.com

# The address for Let's Encrypt's expiry warnings. It is the last line of defence
# behind monitor.sh's certificate check.
MV_ACME_EMAIL=CHOOSE@example.org

# webroot | dns
#   webroot  HTTP-01 through nginx on port 80. Works with EVERY registrar and
#            needs no API credential. The default, and the reason port 80 is
#            open. See README.md, "TLS on 443, and why port 80 is the fourth
#            rule".
#   dns      DNS-01. Needs a certbot plugin for the registrar the owner picks,
#            and that choice has not been made. provision.sh REFUSES rather than
#            guesses; it prints what to install.
MV_ACME_MODE=webroot

# ---------------------------------------------------------------- the ports

# nginx publishes the website and relay on standard HTTPS port 443.
MV_RELAY_PORT=443

# The relay's private upstream. nginx sends /contract-b/ WebSockets here.
# Keep this address on loopback. The relay trusts nginx's single client-address
# header only when the direct connection comes from loopback.
MV_RELAY_BACKEND=127.0.0.1:8795

# The archive's own listener. LOOPBACK, deliberately. docs/defaults-audit.md's
# finding for WP3 is exactly the habit of binding this to 0.0.0.0 on a public
# host; nginx is what publishes the page, and it publishes it read-only, rate
# limited and over TLS. Do not change this to an external address.
MV_ARCHIVE_HTTP=127.0.0.1:8796

# ---------------------------------------------------------------- live broadcast origin

# MediaMTX receives one authenticated RTMP publisher over the existing private
# Lightsail/EC2 peering and exposes HLS only on loopback. nginx is the only
# public reader. The generated publish secret lives on the host, not here.
MV_STREAM_ORIGIN_ENABLED=1

# The live Lightsail private address. Never use the public address or 0.0.0.0:
# ingest is an operator path, not a public endpoint.
MV_STREAM_RTMP_ADDRESS=172.26.12.110:1935

# The private CIDR of the EC2 VPC that contains the broadcast host.
MV_STREAM_PUBLISH_CIDR=172.31.0.0/16

# This is rendered into nginx and must remain loopback-only.
MV_STREAM_HLS_BACKEND=127.0.0.1:8888

# ---------------------------------------------------------------- Decision 3

# ANSWERED by the owner 2026-08-12: `prune-genomes`. The replay experiment this
# was gated on reported the same day and LIFTED the memory constraint rather than
# answering the question — no arm of this list is ruled out inside the announced
# period any more — so the rule was decided on what participants are PROMISED
# rather than on what fits: the LEDGER IS KEPT FOREVER and genome blobs are
# pruned to a horizon (MV_ARCHIVE_GENOME_HORIZON, below). Risk 7 becomes stated
# policy: a blob nobody fetched inside the horizon is permanently unfetchable.
#
# Note that only `bounded-ledger` bounds the MEMORY — the archive's resident set
# grows with ledger records, and pruning genome blobs does not touch that. This
# rule buys disk and the egress behind it, not RAM; size the box from SIZING.md
# §4 either way.
# One of:
#   keep-everything   the ledger and the genome store grow for the whole run.
#                     Sizes the 8 GB bundle. It no longer needs swap or a tight
#                     GOMEMLIMIT proven — the streamed replay (below) is what
#                     bought that. WIND-DOWN.md's arm A applies.
#   bounded-ledger    the ledger is bounded by the retention rule. 2 GB bundle,
#                     the archive restarts in seconds, wind-down arm B applies.
#   prune-genomes     the ledger is kept whole and the genome store is pruned to
#                     a horizon. Wind-down arm B applies to the store only.
#   graduate          the archive becomes M7's catalog ancestor at the ending.
#                     Wind-down arm B, with D6's graduation call recorded.
# It changes NOTHING a script does except the horizon below, the backup tier and
# which arm of the wind-down is announced. It is written here so that the rule has
# one home rather than living in a person's memory (Decision 3, Risk 5).
MV_RETENTION=prune-genomes

# The horizon `prune-genomes` prunes to, as a Go duration. 720h = 30 days, the
# deployment's setting. It reaches the archive as MULTIVERSE_GENOME_HORIZON
# (§23, B33); provision.sh writes it into /etc/multiverse/archive.env, which is
# the only place the archive reads it from.
#
# EMPTY OR 0 MEANS NOTHING IS EVER EVICTED, and that is the contract's default
# and every archive's behaviour before 2026-08-12 — a fresh instance that leaves
# this blank keeps every blob forever, which is safe and is not what was
# announced. THE HORIZON IS A PROMISE TO PARTICIPANTS: it is announced before
# anybody joins (WIND-DOWN.md, ANNOUNCEMENT.md) and shortening it later takes
# back something people were told they had. Lengthening it costs nothing and
# recovers nothing already evicted.
#
# It prunes BLOBS ONLY. The ledger — who crossed, when, and the ancestry links —
# is kept whole and forever, so the lineage graph survives with leaves that age
# out, and a hash whose blob is gone is still a lineage node (§10).
MV_ARCHIVE_GENOME_HORIZON=720h

# The Lightsail bundle actually bought. Informational: monitor.sh reads the real
# memory from the kernel, not from here. Recorded so the box says what it was
# sized for.
MV_BUNDLE=small_3_0

# ---------------------------------------------------------------- the memory verdict

# Go's soft heap ceiling for the archive. MEASURED, 2026-08-12, on a copy of the
# deployment's own 8,156,868-record ledger (wp3_hosting_options.md, "The measured
# answer"); it is a default now rather than a CHOOSE.
#
# The replay itself was fixed first, and that is what actually sizes the box: it
# streams the ledger instead of materialising it, 184 B of peak per record
# against 1,030-1,286 B, so the day-90 peak at the exit-test bar is 4.0 GB rather
# than 28 GB. THIS VALUE IS THE BELT TO THAT BRACE, and it is set to the loosest
# limit the experiment showed helping:
#
#   5GiB   sat far above the streamed peak, so the collector never works for it,
#          while capping any regression that starts holding records again — the
#          same 5 GiB cut the OLD shape's peak from 8.40-10.49 GB to 5.88-6.30 GB
#          at no measurable wall clock and 17-39% more CPU.
#   4GiB / 3GiB   DO NOT. Below about 2x the retained set the trade turns
#          ruinous in the one resource a cheap instance has least of: 7x and 13x
#          the CPU for 1-17% of peak. 1,408 CPU-seconds is >= 12 minutes of wall
#          clock on two vCPUs, and the archive serves nothing for any of it.
#
# EMPTY means unset. On the streamed replay that is survivable; on an 8 GB box it
# leaves nothing between a regression and the OOM killer, so prefer the value.
MV_ARCHIVE_GOMEMLIMIT=5GiB

# systemd MemoryHigh for the archive: a SOFT cgroup ceiling that throttles and
# reclaims rather than killing. Empty writes no drop-in. There is deliberately no
# MemoryMax knob here: a hard cap kills the replay, and the replay is the one
# thing that must not fail.
MV_ARCHIVE_MEMORY_HIGH=

# Swap file size in GB, 0 for none. 0 IS THE VERDICT, not a placeholder: the
# experiment measured RSS staying within 0.1% of its high-water mark for 150
# seconds after the replay ended, so a box that meets its peak in swap is
# thrashing a live heap the collector is walking, for minutes. Swap buys time
# against a peak that no longer exists on the streamed replay. Set it only on a
# 2 GB bundle running keep-everything, where it is the last resort before the
# retention rule.
MV_SWAP_GB=0

# ---------------------------------------------------------------- alerting

# CHOOSE. ntfy | webhook | command | none. See monitor.sh.
MV_ALERT_KIND=ntfy

# For ntfy: a topic nobody can guess. Make one and keep it:
#     echo "https://ntfy.sh/multiverse-$(head -c 9 /dev/urandom | base64 | tr -d '/+=')"
# Subscribe on the phone app or at that URL in a browser. No account, no signup,
# no cost. Whoever knows the URL can read AND post, so treat it as a secret and
# never put it in a document.
MV_ALERT_URL=

# For MV_ALERT_KIND=command only: a program that receives the alert text on
# stdin, with $1 = severity and $2 = check name.
MV_ALERT_COMMAND=

# How long a check may stay bad before it is re-announced. A monitor that alerts
# on every tick gets muted, and a muted monitor is not monitoring; a monitor that
# alerts once and then goes quiet lets a real problem age out of memory. This is
# the compromise: alert on the CHANGE, then once every this many hours while it
# lasts, then once more when it recovers.
MV_ALERT_REPEAT_HOURS=12

# The hour (UTC, 0-23) at which monitor.sh sends its daily "still alive" line.
# This is the dead-man's half of the design: an alert that never arrives because
# the box is off is indistinguishable from silence, and this is what makes the
# silence visible. -1 disables it.
MV_HEARTBEAT_HOUR=9

# ---------------------------------------------------------------- monitor thresholds

# How many peers the map is expected to hold. monitor.sh alerts when the live
# count falls below it. The exit-test bar is 4 non-owner peers plus the owner.
#
# 0 MEANS NO FLOOR: the live count cannot be too low and the peers check watches
# DARK SLOTS ONLY. It ships at 0 because the alternative pages on the first tick
# after provisioning — a fresh map holds nobody — and an operator whose first
# alert is a false one mutes the channel while he is still deciding whether to
# trust it. RAISE IT once the map is populated, to the count the map should hold:
# "peers lost" is one of WP3's own done-when clauses, and at 0 nothing watches it.
# monitor.sh's peers line says so on every run until you do.
MV_EXPECTED_PEERS=0

# A PEER_STATUS older than this means the archive is connected but the map has
# gone quiet. 120000 ms = two minutes, against a broadcast rate measured at
# ~44/min.
MV_STATUS_AGE_WARN_MS=120000

# A lane bypass is normal for a moment and news when it persists. This is how
# many consecutive monitor runs (5 min apart) a non-empty skip list must survive
# before it is an alert. Risk 4: route-around hides a dead peer.
MV_BYPASS_RUNS=3

# Free space on the data filesystem, percent.
MV_DISK_WARN_PCT=25
MV_DISK_CRIT_PCT=12

# Error lines per monitor interval before it is an alert. 0 would page on every
# transient; this is a rate, and the log is where the detail is.
MV_ERROR_ALERT=5

# genomeGaps growth over 24 h before it is an alert. The gap queue is the
# archive's arrears on genome capture and Risk 7 says the unpaid part is
# permanent. On the rig it moved 46,000 -> 155,000 in two days at S=67.9; at a
# public map's rate anything like that is news.
MV_GAPS_DELTA_ALERT=20000

# Days of certificate life left before it is an alert. certbot renews at 30.
MV_CERT_MIN_DAYS=10

# The fraction of (RAM + swap) that the archive's PROJECTED memory may reach
# before it is declared not to fit. monitor.sh projects both terms and alerts on
# the larger: 0.18 KB per ledger record while replaying and 0.30 KB held
# resident. At the exit-test bar an 8 GB box crosses it around day 110 under
# keep-everything, on the resident term — the replay term would not cross until
# day 180. Those constants belong to the archive binary in this kit; one built
# before 2026-08-12 peaks at 1.30 KB/record and crosses at day 26.
MV_REPLAY_HEADROOM=0.85

# ---------------------------------------------------------------- backup

MV_BACKUP_KEEP=168            # identity snapshots to keep (hourly -> 7 days)
MV_BACKUP_LEDGER=auto         # auto | always | never — the compressed ledger copy
MV_BACKUP_LEDGER_MIN_FREE_PCT=30   # `auto` skips the copy below this free space
MV_BACKUP_GENOMES=1           # hardlink snapshot of the genome store (near-free)
MV_BACKUP_DAILY_HOUR=4        # UTC hour for the heavy tier

# ---------------------------------------------------------------- D24

# The announced period. ANNOUNCEMENT.md and WIND-DOWN.md consume these dates.
MV_PERIOD_START=2026-08-14
MV_PERIOD_END=2026-11-14

# ---------------------------------------------------------------- paths and identity

MV_USER=multiverse
MV_GROUP=multiverse
MV_PREFIX=/opt/multiverse
MV_STATE=/var/lib/multiverse
MV_LOGDIR=/var/log/multiverse
MV_TLSDIR=/etc/multiverse/tls
MV_STAGE_DIR=/home/ubuntu/multiverse-stage

# The archive's identity on the ring. Its credential carries the SUBSCRIBE grant,
# which is disjoint from `peer`: it cannot claim a slot (B27).
MV_ARCHIVE_PEER_ID=archive-main

# Log rotation, per process. The ceiling is MB x (KEEP+1) and the disk budget
# counts two processes: 100 x 6 x 2 = 1.2 GB.
MV_LOG_ROTATE_MB=100
MV_LOG_KEEP=5
MV_LOG_LEVEL=info

# The relay's minimum contract version. UNSET IS THE DEFAULT and it is a
# deployment decision, not a security control (B25). Raise it only AFTER the
# release that satisfies it is published, and expect it to partition the map
# along a version boundary until every participant has upgraded.
MV_MIN_CONTRACT_VERSION=
