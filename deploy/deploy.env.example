# Parameters for one hosted relay and archive.
#
# Copy this file to /etc/multiverse/deploy.env.
# Keep the installed file at mode 0640 with owner root:multiverse.
# Do not commit the completed file.
#
# The alert URL can be a secret capability.
# No join string, private key, or cloud credential belongs in this file.

# ---------------------------------------------------------------- name and TLS

# Replace this placeholder with the stable public service name.
MV_DOMAIN=multiverse.example.org

# Add certificate names separated by spaces. Empty is valid.
MV_CERT_EXTRA_NAMES=

# Replace this placeholder with the ACME contact address.
MV_ACME_EMAIL=CHOOSE@example.org

# webroot uses HTTP-01 through nginx. The public kit does not configure DNS-01.
MV_ACME_MODE=webroot

# ---------------------------------------------------------------- listeners

MV_RELAY_PORT=443
MV_RELAY_BACKEND=127.0.0.1:8795
MV_ARCHIVE_HTTP=127.0.0.1:8796

# ---------------------------------------------------------------- public installer enrollment

# The bundled installer creates a different relay credential on each machine.
# nginx exposes only POST /api/enroll. The relay stores a verifier, not the
# secret that the installer generated. Set this to 0 to stop new automatic
# enrollments without disconnecting existing worlds.
MV_PUBLIC_ENROLLMENT=1

# Total automatically enrolled credentials. Manually issued identities and the
# archive identity do not count against this limit. Raise it deliberately after
# checking the map's connection and storage capacity.
MV_PUBLIC_ENROLLMENT_MAX=256

# New identities allowed from one public network address in one window. A retry
# with the same install identity does not consume another entry.
MV_PUBLIC_ENROLLMENT_PER_ADDRESS=8
MV_PUBLIC_ENROLLMENT_WINDOW_HOURS=24

# ---------------------------------------------------------------- optional live broadcast origin

# Keep this disabled unless the deployment has a private RTMP source network.
MV_STREAM_ORIGIN_ENABLED=0

# When enabled, use an RFC1918 address on port 1935.
MV_STREAM_RTMP_ADDRESS=

# When enabled, identify the private publisher CIDR.
MV_STREAM_PUBLISH_CIDR=

# nginx is the only public HLS reader.
MV_STREAM_HLS_BACKEND=127.0.0.1:8888

# ---------------------------------------------------------------- retention policy

# Select one rule before a participant joins:
#   keep-everything
#   bounded-ledger
#   prune-genomes
#   graduate
#
# The public example uses the contract-safe rule that removes nothing.
# Record the selected deployment rule in participant documents and private operations storage.
MV_RETENTION=keep-everything

# A Go duration such as 720h. Empty keeps all genome blobs.
# A shorter value removes blobs during the run and must be announced first.
MV_ARCHIVE_GENOME_HORIZON=

# Informational name for the selected provider size. Do not put a resource ID here.
MV_BUNDLE=CHOOSE

# ---------------------------------------------------------------- archive memory

# Go soft heap limit. Select it from the host's ARCHIVE CEILING, not from total
# RAM: the ceiling is MemTotal less the memory no other process on the box will
# return, and SIZING.md "Archive memory" gives the rule
#
#     MV_ARCHIVE_GOMEMLIMIT <= archive_ceiling / 1.14
#
# where 1.14 is the measured excursion of peak over settled under a binding
# limit. 1100MiB is that rule on a 2 GB host with a measured 1,534 MiB ceiling.
#
# It is a SOFT limit and it cannot fail a replay: a limit set below the live
# heap ran the collector continuously, replayed every record and left the ledger
# byte-identical. What it buys is resident set, by removing collector headroom,
# and on two vCPUs that headroom is 15 to 22 percent larger than on a big box.
# What it does NOT do is reduce retained state, and it does NOT move the
# replay-headroom ratio below, which is a model of record count.
#
# Empty leaves the limit unset. Changing it needs `--only envfiles` and a
# restart: the value is read at exec time.
MV_ARCHIVE_GOMEMLIMIT=1100MiB

# Optional systemd MemoryHigh value. Empty creates no override.
MV_ARCHIVE_MEMORY_HIGH=

# Swap-file size in GB. It is a crash barrier and not replay capacity, so the
# monitor's replay-headroom gate does not count it; the monitor's separate
# `swap` check reports whether it exists and whether it is being used, and
# sustained use means the host needs more memory or less retained state.
# A non-zero value also writes vm.swappiness=10, which keeps the steady-state
# processes resident and still lets a replay peak spill.
#
# 0 is the default because a swap file is a per-host decision that has to be
# recorded. Set it only where the record says so; do not add swap to clear a
# memory verdict, because it cannot clear one.
MV_SWAP_GB=0

# ---------------------------------------------------------------- alerting

# ntfy | webhook | command | none
MV_ALERT_KIND=none

# This value can be a secret capability. Store it only in the installed file.
MV_ALERT_URL=

# For command alerts, the program reads message text from stdin.
# Its first two arguments are severity and check name.
MV_ALERT_COMMAND=

MV_ALERT_REPEAT_HOURS=12
MV_HEARTBEAT_HOUR=9

# ---------------------------------------------------------------- monitor thresholds

# Zero disables the minimum-live-peer floor. Raise it after the map is populated.
MV_EXPECTED_PEERS=0

MV_STATUS_AGE_WARN_MS=120000
MV_BYPASS_RUNS=3
MV_DISK_WARN_PCT=25
MV_DISK_CRIT_PCT=12
MV_ERROR_ALERT=5
MV_GAPS_DELTA_ALERT=20000
MV_CERT_MIN_DAYS=10

# Fraction of PHYSICAL RAM allowed for projected archive memory. Swap is not in
# that denominator: adding a swap file would otherwise halve the number this
# gate reports while the ledger, the retained state and the replay were all
# exactly as they were. Swap has its own check below.
MV_REPLAY_HEADROOM=0.85

# The per-record memory model the gate above projects with, in whole bytes per
# ledger record. SIZING.md "Archive memory" owns these values and states the
# workload they were measured on. They are settable so that a measurement taken
# on THIS host's ledger can retune the gate without a new release. Changing them
# changes when the gate trips and nothing else.
#
# BOTH CARRY THE SAME VALUE, and that is the measurement, not a shortcut: the
# replay peak and the settled resident set were 0.06 percent apart in every run
# with no binding limit. There is one memory term, not two. monitor.sh keeps its
# max() against a future model change.
#
# 110 is the resident set measured on 2026-08-16, on two pinned cores, replaying
# a real 5,408,123-record ledger with the fingerprinted duplicate-suppression
# set and NO genome store — a restore from the ledger alone, which is the worst
# shape a real start can take. The live service shape measured about 64 B, so
# this value carries 1.7x of margin and still describes a replay this host can
# be asked to run. The build before the fingerprint change needed 280 here, and
# monitor.sh's own defaults (184 and 300) are the older reference-workload
# figures, kept conservative so an unconfigured host errs toward calling itself
# full rather than free.
MV_REPLAY_PEAK_B=110
MV_REPLAY_RESIDENT_B=110

# Swap, watched as its own reading rather than counted as headroom. Report it
# when this percentage of the swap device stays in use for this many
# consecutive five-minute passes. SIZING.md reads sustained swap activity as a
# sizing signal — the instance needs more memory or less retained state — and a
# single replay peak that spills and is reclaimed is not that.
MV_SWAP_USED_WARN_PCT=25
MV_SWAP_USED_RUNS=3

# ---------------------------------------------------------------- data transfer

# The bundle's monthly transfer allowance in the PROVIDER's GB, which is 2^30
# bytes and the same base as the free-disk figures above. It is counted in BOTH
# directions, and overage is billed per GB and is NOT throttled, so going over
# is an invoice rather than an outage. Set it to the figure your bundle states.
MV_TRANSFER_ALLOWANCE_GB=3072

# Warn at this percentage of the allowance, taking the higher of the
# month-to-date burn-down line and the last 24 closed hours' projected month.
# A hundred percent is critical.
MV_TRANSFER_WARN_PCT=80

# Points of clearance the figure must gain below a threshold before the severity
# steps back DOWN. A deployment whose steady state sits on the line would
# otherwise alert and recover every five minutes until somebody muted it.
MV_TRANSFER_HYST_PCT=3

# Empty reads the default-route interface from /proc/net/route. Name the billed
# interface here if the host has more than one. The monitor unit forbids
# AF_NETLINK, so `ip` cannot be used to find it and must not be introduced.
MV_TRANSFER_IFACE=

# The rate trip: in and out together above this many GB in one closed hour, for
# this many consecutive hours, is a driver that just appeared. Keep it well
# above the rate the allowance sustains so that it means "something started"
# rather than "this month is busy".
MV_TRANSFER_HOURLY_GB=9
MV_TRANSFER_HOURLY_RUNS=3

# ------------------------------------------------- daily billing reconciliation

# The transfer knobs above watch this host's own NIC counter, which needs no
# cloud credential and is the only instrument this host can hold. It is a proxy.
# `deploy/ce-reconcile.sh` audits it against the invoice: it runs on an OPERATOR
# machine once a day, makes exactly one Cost Explorer call, and writes
# `billing.json` into the monitor's state directory over ssh. This host still
# holds no cloud credential, which is the point.
#
# The two knobs below belong to the monitor's `billing` check, which reads that
# file. The script itself is configured from the operator machine's environment
# and reads nothing from this file.

# Hours before a reconciliation is stale. A daily job, plus one missed run, plus
# the provider's own roughly fourteen-hour billing lag, all fit inside 36 — so
# one failed run is not an alert and two are. Missing or stale is a WARNING and
# never a critical: the NIC counter is still watching the allowance, so what has
# been lost is the audit and not the alarm.
MV_BILLING_STALE_HOURS=36

# How far the metric-over-invoice ratio may sit from 1 before the two
# instruments are called into question. The measured residual is a systematic
# 1.01 and is NOT corrected anywhere — correcting a residual nobody can explain
# hides the day it changes. 0.10 lets 1.01 through and still catches a counter
# that has started reading the wrong interface, the wrong instance, or a
# decimal GB.
MV_BILLING_RATIO_TOL=0.10

# ---------------------------------------------------------------- backups

MV_BACKUP_KEEP=168
MV_BACKUP_LEDGER=auto
MV_BACKUP_LEDGER_MIN_FREE_PCT=30
MV_BACKUP_GENOMES=1
MV_BACKUP_DAILY_HOUR=4

# ---------------------------------------------------------------- announced period

# Replace both placeholders before a participant joins.
MV_PERIOD_START=YYYY-MM-DD
MV_PERIOD_END=YYYY-MM-DD

# ---------------------------------------------------------------- paths and identity

MV_USER=multiverse
MV_GROUP=multiverse
MV_PREFIX=/opt/multiverse
MV_STATE=/var/lib/multiverse
MV_LOGDIR=/var/log/multiverse
MV_TLSDIR=/etc/multiverse/tls
MV_STAGE_DIR=/home/ubuntu/multiverse-stage

# The archive credential has the subscribe grant and cannot claim a map slot.
MV_ARCHIVE_PEER_ID=archive-main

# The peer id of the world the shared camera at /watch is showing. NOTHING ON
# THE WIRE CARRIES THIS: a world does not announce that it is being filmed, so
# the deployment that runs the publisher is the only party that knows. With it
# set, /watch names that world and draws its place in the grid, and the live map
# badges the same world and links back to the broadcast.
#
# EMPTY IS THE DEFAULT and is correct for a map with no broadcast: both pages
# then say the world is unknown rather than name the wrong one. It is display
# only — it changes no placement, no routing and no record — and it is a public
# identifier, not a secret. Change it when the publisher moves to another world.
MV_BROADCAST_PEER_ID=

# Homepage metadata for the public landing page's links. There is no release
# value here: the page's download buttons address GitHub's /releases/latest, so
# they follow the newest published release on their own and a release never
# needs this host to be touched. An MV_HOMEPAGE_RELEASE= line left over in a
# host's copy of this file is ignored and harmless; delete it at the next
# deployment.
MV_HOMEPAGE_REPO=jpinedaa/bibites-multiverse
MV_HOMEPAGE_GAME_VERSION=0.6.3.1

MV_LOG_ROTATE_MB=100
MV_LOG_KEEP=5
MV_LOG_LEVEL=info

# Leave empty unless the published release supports the selected floor.
MV_MIN_CONTRACT_VERSION=
