[Unit]
Description=Bibites Multiverse archive (Contract B subscriber, status page)
Documentation=file:///opt/multiverse/deploy/RESTART-POLICY.md
# ORDERING ONLY, and the relay is named HERE AND NOWHERE ELSE IN THIS UNIT.
# After= without Wants= is the whole point: Wants= is a START-TIME PULL, so
# `systemctl restart multiverse-archive` would start a relay the operator had
# just stopped on purpose. That silently defeats the record-preserving sequence
# in RESTART-POLICY.md — the map runs live for the whole replay and NOTHING
# RECORDS IT, while the operator believes they avoided exactly that. Boot needs
# no pull: both units carry WantedBy=multi-user.target and provision.sh enables
# both, so the target starts the relay and After= only orders it first.
After=network-online.target multiverse-relay.service
# And NOT Requires= either, for the reason that came first: the archive retries
# its subscription on its own ladder, so it should keep trying while the relay
# is down rather than be stopped with it — and a relay restart must not cost an
# archive replay, which is the expensive one.
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=6

[Service]
Type=simple
User=multiverse
Group=multiverse
WorkingDirectory=/var/lib/multiverse

# EVERY setting the archive reads arrives here, and there is deliberately no
# Environment= line in this unit: a literal here would be applied AFTER the file
# and would silently win over deploy.env, which is the one home the kit promises.
# provision.sh generates the file, including MULTIVERSE_GENOME_HORIZON and the
# archive GOMEMLIMIT. An empty genome horizon evicts nothing.
EnvironmentFile=/etc/multiverse/archive.env
ExecStart=/opt/multiverse/bin/multiverse-archive

Restart=always
# Longer than the relay's: a restart loop here replays the whole ledger each
# time, and a tight loop would be a self-inflicted denial of service on a box
# with two vCPUs.
RestartSec=15s
# The archive's own shutdown gives itself 5 s and then warns. This leaves room
# for a flush without letting a wedged process hold the boot.
TimeoutStopSec=45

NoNewPrivileges=true

# The archive is the process that may legitimately want gigabytes. Its resident
# set and its replay peak are ONE number, measured at ~110 B per ledger record
# on two vCPUs for the worst real start (a restore with no genome store) and
# ~64 B for the live shape. SIZING.md "Archive memory" owns those figures.
# Under pressure this is the one to lose. Losing it costs a ledger gap, but
# losing the relay stops the map.
OOMScoreAdjust=+200
# THERE IS NO MemoryMax HERE, AND THAT IS DELIBERATE. A hard cap kills the
# replay, and the replay is the one thing that must not fail. provision.sh writes
# a MemoryHigh drop-in when deploy.env sets one: MemoryHigh throttles and
# reclaims, it does not kill.
#
# The replay also saturates a core while it runs. On a two-vCPU box that is the
# whole machine, so it yields to the relay rather than competing with it.
Nice=5

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# migrations.jsonl, metrics.jsonl, genomes/ and the rotated log.
ReadWritePaths=/var/lib/multiverse/archive /var/log/multiverse

[Install]
WantedBy=multi-user.target
