[Unit]
Description=Bibites Multiverse archive (Contract B subscriber, status page)
Documentation=file:///opt/multiverse/deploy/RESTART-POLICY.md
# The archive must finish its replay before the relay opens. It therefore has no
# dependency on the relay: its own reconnect ladder waits while the relay unit's
# readiness gate waits for /healthz. The relay binds to this unit in the other
# direction, so an archive failure closes the map instead of leaving an
# unrecorded interval.
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=6

[Service]
Type=simple
User=multiverse
Group=multiverse
WorkingDirectory=/var/lib/multiverse

# EVERY setting the archive reads arrives here, and there is deliberately no
# Environment= line in this unit: a literal here would be applied AFTER the file
# and would silently win over deploy.env, which is the one home the kit promises.
# provision.sh generates the file, including MULTIVERSE_GENOME_HORIZON and the
# archive GOMEMLIMIT. An empty genome horizon evicts nothing.
EnvironmentFile=/etc/multiverse/archive.env
ExecStart=/opt/multiverse/bin/multiverse-archive

Restart=always
# Longer than the relay's: a restart loop here replays the whole ledger each
# time, and a tight loop would be a self-inflicted denial of service on a box
# with two vCPUs.
RestartSec=15s
# A cgroup MemoryMax hit terminates the main process with SIGKILL. Replaying the
# same state again under the same cap is a host-pressure loop, not recovery.
# Fail stopped; BindsTo= on the relay takes the map down with the recorder.
RestartPreventExitStatus=SIGKILL
OOMPolicy=kill
# The archive's own shutdown gives itself 5 s and then warns. This leaves room
# for a flush without letting a wedged process hold the boot.
TimeoutStopSec=45

NoNewPrivileges=true

# The archive is the process that may legitimately want gigabytes. Its resident
# set and its replay peak are ONE number, measured at ~110 B per ledger record
# on two vCPUs for the worst real start (a restore with no genome store) and
# ~64 B for the live shape. SIZING.md "Archive memory" owns those figures.
# Under pressure this is the one to lose. Losing it costs a ledger gap, but
# losing the relay stops the map.
OOMScoreAdjust=+200
# provision.sh writes optional MemoryHigh, MemoryMax, and MemorySwapMax values
# into a deployment-specific drop-in. The unit stays reusable across host
# sizes, while a production deployment can contain a bad replay inside this
# service instead of allowing host-wide OOM kills. SIZING.md owns the selection
# rule; a MemoryMax hit is a capacity failure, not a successful replay.
#
# The replay also saturates a core while it runs. On a two-vCPU box that is the
# whole machine, so it yields to the relay rather than competing with it.
Nice=5

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# migrations.jsonl, metrics.jsonl, genomes/ and the rotated log.
ReadWritePaths=/var/lib/multiverse/archive /var/log/multiverse

[Install]
WantedBy=multi-user.target
